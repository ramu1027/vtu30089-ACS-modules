        "\n",
        "print(\"Traffic Signal Congestion Analyzer\")\n",
        "\n",
        "vehicles = int(input(\"Enter number of vehicles: \"))\n",
        "\n",
        "if vehicles < 0:\n",
        "    print(\"Invalid number of vehicles.\")\n",
        "else:\n",
        "    signal = input(\"Enter signal color (RED/GREEN): \").upper()\n",
        "\n",
        "    if vehicles <= 10:\n",
        "        print(\"Congestion Level: LOW\")\n",
        "        green_time = 15\n",
        "    elif vehicles <= 30:\n",
        "        print(\"Congestion Level: MEDIUM\")\n",
        "        green_time = 30\n",
        "    else:\n",
        "        print(\"Congestion Level: HIGH\")\n",
        "        green_time = 60\n",
        "\n",
        "    print(\"Recommended Green Time:\", green_time, \"seconds\")\n",
        "\n",
        "    if signal == \"RED\":\n",
        "        print(\"Signal Status: RED - Please Wait\")\n",
        "    elif signal == \"GREEN\":\n",
        "        print(\"Signal Status: GREEN - You Can Move\")\n",
        "    else:\n",
        "        print(\"Invalid signal color.\")\n"
