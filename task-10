      ],
      "source": [
        "\n",
        "\n",
        "\n",
        "\n",
        "def dfs(graph, node, visited):\n",
        "    visited.add(node)\n",
        "\n",
        "    for neighbor in graph[node]:\n",
        "        if neighbor not in visited:\n",
        "            dfs(graph, neighbor, visited)\n",
        "\n",
        "\n",
        "print(\"Campus Network Connectivity Checker\")\n",
        "\n",
        "n = int(input(\"Enter number of computers: \"))\n",
        "e = int(input(\"Enter number of network connections: \"))\n",
        "\n",
        "if n <= 0 or e < 0 or e > n * (n - 1) // 2:\n",
        "    print(\"Invalid number of computers or connections.\")\n",
        "else:\n",
        "    graph = {i: [] for i in range(1, n + 1)}\n",
        "    valid = True\n",
        "\n",
        "    print(\"Enter connections (computer1 computer2):\")\n",
        "\n",
        "    for _ in range(e):\n",
        "        u, v = map(int, input().split())\n",
        "\n",
        "        if u < 1 or u > n or v < 1 or v > n or u == v:\n",
        "            print(\"Invalid connection.\")\n",
        "            valid = False\n",
        "            break\n",
        "\n",
        "        graph[u].append(v)\n",
        "        graph[v].append(u)\n",
        "\n",
        "    if valid:\n",
        "        visited = set()\n",
        "        dfs(graph, 1, visited)\n",
        "\n",
        "        print(\"\\nConnected Computers:\", sorted(visited))\n",
        "\n",
        "        if len(visited) == n:\n",
        "            print(\"Network Status: FULLY CONNECTED\")\n",
        "        else:\n",
        "            print(\"Network Status: NOT FULLY CONNECTED\")\n",
        "            print(\"Disconnected Computers:\",\n",
        "                  sorted(set(range(1, n + 1)) - visited))\n"
      ]
    }
