        "\n",
        "from collections import deque\n",
        "\n",
        "def find_route(graph, start, treasure):\n",
        "    queue = deque([[start]])\n",
        "    visited = {start}\n",
        "\n",
        "    while queue:\n",
        "        path = queue.popleft()\n",
        "        current = path[-1]\n",
        "\n",
        "        if current == treasure:\n",
        "            return path\n",
        "\n",
        "        for room in graph[current]:\n",
        "            if room not in visited:\n",
        "                visited.add(room)\n",
        "                queue.append(path + [room])\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "print(\"Museum Treasure Route Planner\")\n",
        "\n",
        "n = int(input(\"Enter number of museum rooms: \"))\n",
        "e = int(input(\"Enter number of room connections: \"))\n",
        "\n",
        "if n <= 0 or e < 0:\n",
        "    print(\"Invalid input.\")\n",
        "else:\n",
        "    graph = {i: [] for i in range(1, n + 1)}\n",
        "    valid = True\n",
        "\n",
        "    print(\"Enter connections between rooms:\")\n",
        "    for _ in range(e):\n",
        "        u, v = map(int, input().split())\n",
        "\n",
        "        if not (1 <= u <= n and 1 <= v <= n) or u == v:\n",
        "            print(\"Invalid room connection.\")\n",
        "            valid = False\n",
        "            break\n",
        "\n",
        "        graph[u].append(v)\n",
        "        graph[v].append(u)\n",
        "\n",
        "    if valid:\n",
        "        start = int(input(\"Enter starting room: \"))\n",
        "        treasure = int(input(\"Enter treasure room: \"))\n",
        "\n",
        "        if not (1 <= start <= n and 1 <= treasure <= n):\n",
        "            print(\"Invalid starting or treasure room.\")\n",
        "        else:\n",
        "            route = find_route(graph, start, treasure)\n",
        "\n",
        "            if route:\n",
        "                print(\"\\nShortest Treasure Route:\")\n",
        "                print(\" -> \".join(map(str, route)))\n",
        "                print(\"Rooms Visited in Route:\", len(route))\n",
        "                print(\"Connections Travelled:\", len(route) - 1)\n",
        "            else:\n",
        "                print(\"No route to the treasure exists.\")\n",
        "\n",
        "\n",
        "\n"
