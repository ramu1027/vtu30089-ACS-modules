      ],
      "source": [
        "\n",
        "from collections import Counter\n",
        "\n",
        "print(\"Warehouse Product Frequency Manager\")\n",
        "\n",
        "n = int(input(\"Enter number of products: \"))\n",
        "\n",
        "if n <= 0:\n",
        "    print(\"Invalid number of products.\")\n",
        "else:\n",
        "    products = []\n",
        "\n",
        "    print(\"Enter product names:\")\n",
        "    for i in range(n):\n",
        "        product = input().strip().upper()\n",
        "        products.append(product)\n",
        "\n",
        "    frequency = Counter(products)\n",
        "\n",
        "    print(\"\\nWarehouse Product Frequency Report\")\n",
        "    print(\"-----------------------------------\")\n",
        "\n",
        "    for product, count in frequency.items():\n",
        "        print(f\"{product} : {count} time(s)\")\n",
        "\n",
        "    print(\"\\nTotal product entries:\", n)\n",
        "    print(\"Unique products:\", len(frequency))\n"
      ]
    }
  ]
