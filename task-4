      "source": [
        "\n",
        "print(\"Server Request Validator\")\n",
        "\n",
        "method = input(\"Enter HTTP method (GET/POST/PUT/DELETE): \").upper()\n",
        "path = input(\"Enter URL path: \").strip()\n",
        "token = input(\"Enter authentication token: \").strip()\n",
        "\n",
        "valid_methods = [\"GET\", \"POST\", \"PUT\", \"DELETE\"]\n",
        "\n",
        "if method not in valid_methods:\n",
        "    print(\"Request Status: INVALID\")\n",
        "    print(\"Reason: Invalid HTTP method\")\n",
        "\n",
        "elif not path.startswith(\"/\") or \" \" in path or not path:\n",
        "    print(\"Request Status: INVALID\")\n",
        "    print(\"Reason: Invalid URL path\")\n",
        "\n",
        "elif not token:\n",
        "    print(\"Request Status: INVALID\")\n",
        "    print(\"Reason: Missing authentication token\")\n",
        "\n",
        "else:\n",
        "    print(\"Request Status: VALID\")\n",
        "    print(\"HTTP Method:\", method)\n",
        "    print(\"URL Path:\", path)\n",
        "    print(\"Authentication: Present\")\n",
        "\n"
      ]
    }
