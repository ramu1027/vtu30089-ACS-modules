      "source": [
        "\n",
        "print(\"Factory Temperature Monitor\")\n",
        "\n",
        "n = int(input(\"Enter number of temperature readings: \"))\n",
        "\n",
        "if n <= 0:\n",
        "    print(\"Invalid number of readings.\")\n",
        "else:\n",
        "    temperatures = []\n",
        "\n",
        "    for i in range(n):\n",
        "        temp = float(input(f\"Enter temperature {i + 1} (°C): \"))\n",
        "        temperatures.append(temp)\n",
        "\n",
        "    print(\"\\nFactory Temperature Report\")\n",
        "    print(\"--------------------------\")\n",
        "\n",
        "    for i, temp in enumerate(temperatures, start=1):\n",
        "        if temp < 10:\n",
        "            status = \"LOW TEMPERATURE\"\n",
        "        elif temp <= 80:\n",
        "            status = \"NORMAL\"\n",
        "        else:\n",
        "            status = \"HIGH TEMPERATURE - ALERT\"\n",
        "\n",
        "        print(f\"Reading {i}: {temp:.1f}°C - {status}\")\n",
        "\n",
        "    average = sum(temperatures) / n\n",
        "    maximum = max(temperatures)\n",
        "    minimum = min(temperatures)\n",
        "\n",
        "    print(\"\\nAverage Temperature:\", round(average, 2), \"°C\")\n",
        "    print(\"Maximum Temperature:\", maximum, \"°C\")\n",
        "    print(\"Minimum Temperature:\", minimum, \"°C\")\n",
        "\n",
        "    if maximum > 80:\n",
        "        print(\"Factory Status: WARNING - Check the equipment\")\n",
        "    else:\n",
        "        print(\"Factory Status: TEMPERATURE WITHIN SAFE RANGE\")\n",
        "\n"
      ]
