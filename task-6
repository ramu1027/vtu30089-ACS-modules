      ],
      "source": [
        "\n",
        "def cpu_scheduler():\n",
        "    print(\"Intelligent CPU Task Scheduler\")\n",
        "\n",
        "    n = int(input(\"Enter number of processes: \"))\n",
        "\n",
        "    if n <= 0:\n",
        "        print(\"Invalid number of processes.\")\n",
        "        return\n",
        "\n",
        "    processes = []\n",
        "\n",
        "    for i in range(n):\n",
        "        print(f\"\\nProcess P{i + 1}\")\n",
        "        burst = int(input(\"Enter burst time: \"))\n",
        "        priority = int(input(\"Enter priority (lower number = higher priority): \"))\n",
        "\n",
        "        if burst <= 0 or priority <= 0:\n",
        "            print(\"Burst time and priority must be positive.\")\n",
        "            return\n",
        "\n",
        "        processes.append({\n",
        "            \"pid\": f\"P{i + 1}\",\n",
        "            \"burst\": burst,\n",
        "            \"priority\": priority\n",
        "        })\n",
        "\n",
        "    # Priority scheduling; preserve input order for equal priorities\n",
        "    processes.sort(key=lambda p: p[\"priority\"])\n",
        "\n",
        "    waiting_time = 0\n",
        "    total_waiting = 0\n",
        "    total_turnaround = 0\n",
        "\n",
        "    print(\"\\nCPU Scheduling Results\")\n",
        "    print(\"-\" * 65)\n",
        "    print(f\"{'Process':<10}{'Burst':<10}{'Priority':<10}\"\n",
        "          f\"{'Waiting':<12}{'Turnaround':<12}\")\n",
        "\n",
        "    for p in processes:\n",
        "        turnaround_time = waiting_time + p[\"burst\"]\n",
        "\n",
        "        print(f\"{p['pid']:<10}{p['burst']:<10}{p['priority']:<10}\"\n",
        "              f\"{waiting_time:<12}{turnaround_time:<12}\")\n",
        "\n",
        "        total_waiting += waiting_time\n",
        "        total_turnaround += turnaround_time\n",
        "        waiting_time = turnaround_time\n",
        "\n",
        "    print(\"-\" * 65)\n",
        "    print(\"Execution Order:\", \" -> \".join(p[\"pid\"] for p in processes))\n",
        "    print(\"Average Waiting Time:\", round(total_waiting / n, 2))\n",
        "    print(\"Average Turnaround Time:\", round(total_turnaround / n, 2))\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    cpu_scheduler()\n",
        "\n"
      ]
