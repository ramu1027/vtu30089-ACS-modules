      "source": [
        "\n",
        "print(\"Employee Hierarchy Analyzer\")\n",
        "\n",
        "employees = {}\n",
        "\n",
        "n = int(input(\"Enter number of employees: \"))\n",
        "\n",
        "if n <= 0:\n",
        "    print(\"Invalid number of employees.\")\n",
        "else:\n",
        "    for i in range(n):\n",
        "        print(f\"\\nEmployee {i + 1}\")\n",
        "        emp_id = input(\"Enter employee ID: \").strip()\n",
        "        name = input(\"Enter employee name: \").strip()\n",
        "        manager_id = input(\"Enter manager ID (or NONE): \").strip().upper()\n",
        "\n",
        "        employees[emp_id] = {\n",
        "            \"name\": name,\n",
        "            \"manager\": manager_id\n",
        "        }\n",
        "\n",
        "    print(\"\\nEmployee Hierarchy Report\")\n",
        "    print(\"-------------------------\")\n",
        "\n",
        "    for emp_id, details in employees.items():\n",
        "        manager_id = details[\"manager\"]\n",
        "\n",
        "        if manager_id == \"NONE\":\n",
        "            manager_name = \"No Manager (Top Level)\"\n",
        "        elif manager_id in employees:\n",
        "            manager_name = employees[manager_id][\"name\"]\n",
        "        else:\n",
        "            manager_name = \"Manager Not Found\"\n",
        "\n",
        "        print(\"Employee ID:\", emp_id)\n",
        "        print(\"Employee Name:\", details[\"name\"])\n",
        "        print(\"Reports To:\", manager_name)\n",
        "        print(\"-------------------------\")\n",
        "\n",
        "    print(\"Total Employees:\", len(employees))\n",
        "\n"
      ]
    }
